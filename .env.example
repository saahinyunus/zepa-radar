# =====================================================================
# Global Freelance & B2B Lead Radar - environment template
# Copy to `.env` for local runs. For GitHub Actions add each key under
# Settings -> Secrets and variables -> Actions. NEVER commit a real .env.
# =====================================================================

# --- Execution mode: TELEGRAM_SAAS | APIFY_ACTOR ---------------------
EXECUTION_MODE=TELEGRAM_SAAS

# --- Groq AI (https://console.groq.com/keys) --------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used automatically if the primary model's free quota runs out (set "none" to disable)
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Stage-1 triage model (cheap, rejects non-leads before the 70B model runs)
GROQ_TRIAGE_MODEL=openai/gpt-oss-20b
TRIAGE_MIN_SCORE=45

# --- Database ---------------------------------------------------------
# Leave SUPABASE_* empty to use the local SQLite file (local testing only:
# GitHub Actions runners are ephemeral, so use Supabase in production).
# Use the "service_role" key (Project Settings -> API), not the anon key.
SUPABASE_URL=
SUPABASE_KEY=
SQLITE_PATH=radar_state.db

# --- Telegram ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Private supergroup (Topics enabled), e.g. -1001234567890
TELEGRAM_VIP_GROUP_ID=
# Public free channel, e.g. -1009876543210 or @my_free_channel
TELEGRAM_FREE_CHANNEL_ID=
# Your own Telegram user ID (optional): health alerts are sent there as a private message.
TELEGRAM_ADMIN_CHAT_ID=

# Topic (forum thread) IDs inside the VIP supergroup
TOPIC_ID_SOFTWARE=
TOPIC_ID_DESIGN=
TOPIC_ID_VIDEO=
TOPIC_ID_MARKETING=

# --- Webhook service (src/lemon_webhook.py) ---------------------------
# Bot username without "@" (shown on the /welcome page)
TELEGRAM_BOT_USERNAME=
# Any long random string; passed to Telegram's setWebhook as secret_token
TELEGRAM_WEBHOOK_SECRET=
INVITE_LINK_TTL_HOURS=72

# --- Lemon Squeezy ----------------------------------------------------
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/your-variant-id

# --- Optional tuning (defaults shown) ---------------------------------
# Set to false to pause the delayed Free-channel teasers (VIP keeps working)
FREE_CHANNEL_ENABLED=true
VIP_MIN_SCORE=60
FREE_DELAY_HOURS=4
LEAD_MAX_AGE_MINUTES=360
MAX_AI_CALLS_PER_RUN=40
# Freelancer.com source: best-budget projects per run and the minimum fixed budget (USD)
FREELANCER_MAX_PER_RUN=10
FREELANCER_MIN_BUDGET_USD=150
GROQ_CONCURRENCY=3
RUN_TIME_BUDGET_SECONDS=190
RETENTION_DAYS=30
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3
REDDIT_USER_AGENT=
# Reddit groups fetched per run in TELEGRAM_SAAS mode (0 = all four)
REDDIT_GROUPS_PER_RUN=3
LOG_LEVEL=INFO
# Scoring v2: leads per UTC day posted to the VIP group (0 = no cap) and per workflow run
VIP_DAILY_CAP=20
VIP_MAX_PER_RUN=4
# Switch sources off without touching code (see SOURCES.md), e.g. DISABLED_SOURCES=freelancer
DISABLED_SOURCES=
ENABLED_JOB_BOARDS=remoteok,jobicy,weworkremotely
# Ready-made pitch in the AI output: off for Telegram (every member would send the same text)
GENERATE_PITCH=false
